    witcher:armor 6 ;
    witcher:caption "Manticore claws never stop growing, so they must occasionally shed them by scratching various surfaces. They seem they find armor and shields particularly convenient." ;
    witcher:deck "TB Monsters" ;
    witcher:image "Gwent cardart monsters manticore right leg.png" ;
    witcher:name "Manticore Right Leg" ;
    witcher:strength 12 ;
    witcher:tags dbr:Boss,
        "Boss" .

dbr:Manticore_Right_Wing_Thronebreaker_card a witcher:Thronebreaker_cards ;
    rdfs:label "Manticore Right Wing (Thronebreaker card)" ;
    witcher:caption "It should be impossible for a mammalian beast the size of a manticore to fly. And yet..." ;
    witcher:deck "TB Monsters" ;
    witcher:image "Gwent cardart monsters manticore right wing.png" ;
    witcher:name "Manticore Right Wing" ;
    witcher:strength 14 .


        "+125 Vitality",
        "+13% Resistance to bludgeoning damage",
        "+13% Resistance to damage from The Witcher 3 bestiary|monsters",
        "+13% Resistance to piercing damage",
        "+18% Resistance to damage from monsters",
        "+25% Resistance to slashing damage",
        "+5% Resistance to bludgeoning damage",
        "+5% Resistance to piercing damage",
        "+75 Vitality",
        "+9% Resistance to slashing damage",
        "New Game +:",
        "Regular game:" ;

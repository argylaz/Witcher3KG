        "Formula: Greater mutagen transmutator - red to green|Greater mutagen transmutator - red to green",
        "Torn-out page: Greater green mutagen|Greater green mutagen" ;
    witcher:alchemy_ingredients dbr:Celandine,
        dbr:Ergot_seeds,

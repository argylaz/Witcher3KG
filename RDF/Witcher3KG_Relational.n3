        dbr:Yennefer_of_Vengerberg,
        "Yennefer of Vengerberg|Yennefer's room in Vizima" ;
    witcher:type dbr:The_Witcher_3_medium_armor,
        "The Witcher 3 medium armor|Medium armor" ;
    witcher:weight 4.77e+00 .

